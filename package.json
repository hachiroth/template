{
  "name": "template",
  "version": "0.0.1",
  "type": "module",
  "description": "Project templates setup.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest",
    "dev": "tsdown && cross-env NODE_ENV=development  node dist/index.js",
    "start": "tsdown && cross-env NODE_ENV=production node dist/index.js",
    "lint": "prettier --check . && eslint . --ext .js,.ts && cspell lint .",
    "lint:fix": "prettier --write . && eslint . --ext .js,.ts --fix && cspell lint .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "dotenv-flow": "^4.1.0"
  },
  "devDependencies": {
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.6.2",
    "cross-env": "^10.1.0",
    "cspell": "^9.2.1",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
